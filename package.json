{
  "name": "remark-docx",
  "version": "0.5.4",
  "description": "remark plugin to compile markdown to docx (Microsoft Word, Office Open XML).",
  "main": "lib/index.cjs",
  "module": "lib/index.js",
  "types": "lib/index.d.ts",
  "type": "module",
  "exports": {
    "./package.json": "./package.json",
    ".": {
      "types": "./lib/index.d.ts",
      "require": "./lib/index.cjs",
      "default": "./lib/index.js"
    },
    "./plugins/*": {
      "types": "./lib/plugins/*/index.d.ts",
      "require": "./lib/plugins/*/index.cjs",
      "default": "./lib/plugins/*/index.js"
    }
  },
  "files": [
    "lib"
  ],
  "sideEffects": false,
  "scripts": {
    "build": "vite build",
    "test": "vitest run --project unit",
    "test:cli": "vitest run --project cli",
    "tsc": "tsc -p . --noEmit",
    "storybook": "storybook dev -p 6006",
    "storybook:build": "storybook build",
    "typedoc": "typedoc",
    "format": "prettier '**/*.{js,ts,jsx,tsx}' --write --cache",
    "format:ci": "prettier '**/*.{js,ts,jsx,tsx}' -l",
    "prepublishOnly": "npm run typedoc && npm run build"
  },
  "dependencies": {
    "deepmerge": "^4.3.1",
    "docx": "^9.16.0",
    "github-slugger": "^2.0.0",
    "image-size": "^2.1.0",
    "mdast-util-definitions": "^6.0.0",
    "mdast-util-to-string": "^4.0.0",
    "shiki": "^4.6.0",
    "unist-util-visit": "^5.2.0"
  },
  "devDependencies": {
    "@prettier/plugin-xml": "^3.4.2",
    "@storybook/react-vite": "^10.6.7",
    "@types/file-saver": "^2.0.7",
    "@types/lodash.debounce": "^4.0.9",
    "@types/mdast": "^4.0.3",
    "@types/node": "^24.10.4",
    "@types/react": "^19.2.7",
    "@types/react-dom": "^19.2.3",
    "@types/unist": "^3.0.0",
    "adm-zip": "^0.6.0",
    "docx-preview": "^0.4.1",
    "file-saver": "^2.0.5",
    "lodash.debounce": "^4.0.8",
    "mermaid": "^12.3.0",
    "prettier": "^3.10.1",
    "react": "^19.3.1",
    "react-dom": "^19.3.1",
    "remark-cli": "^12.0.1",
    "remark-frontmatter": "^5.0.0",
    "remark-gfm": "^4.0.0",
    "remark-math": "^6.0.0",
    "remark-parse": "^11.0.0",
    "storybook": "^10.6.7",
    "typedoc": "^0.28.14",
    "typedoc-plugin-markdown": "^4.9.0",
    "typescript": "^6.0.0",
    "unified": "^11.0.4",
    "vite": "^8.3.8",
    "vite-plugin-dts": "^5.0.2",
    "vitest": "^5.1.1"
  },
  "repository": {
    "type": "git",
    "url": "git+https://github.com/inokawa/remark-docx.git"
  },
  "keywords": [
    "unist",
    "remark",
    "mdast",
    "markdown",
    "docx",
    "word",
    "office",
    "openxml",
    "pandoc",
    "highlight",
    "latex",
    "math",
    "mermaid"
  ],
  "author": "inokawa <stratoooo-taster@yahoo.co.jp> (https://github.com/inokawa/)",
  "license": "MIT",
  "bugs": {
    "url": "https://github.com/inokawa/remark-docx/issues"
  },
  "homepage": "https://github.com/inokawa/remark-docx#readme"
}
